# Auto detect text files and perform LF normalization
* text=auto

# Frozen external evidence bundles are byte-exact imports whose hashes are
# recorded in an import manifest and verified by test. Line-ending
# normalisation would change those bytes on checkout and break verification on
# any platform whose convention differs from the one that produced them, so
# normalisation is disabled for every imported source-data bundle.
#
# In pRoteomics this rule covered manuscript/figure1_bridge_mmmsociability/**.
# The bridge now lives under source_data/MMMSociability/**, and the pRoteomics
# publication source data imported alongside it needs the same protection.
source_data/** -text
figures/main/** -text
figures/extended_data/** -text
